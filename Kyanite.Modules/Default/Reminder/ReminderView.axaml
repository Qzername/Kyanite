<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Kyanite.Modules.Default.Reminder.ReminderView">
    <StackPanel>
        <TextBlock Text="Reminder module, for now it only sends notifications"/>
        <TextBox PlaceholderText="Enter title" 
                 Text="{Binding NotificationTitle}"/>
        <TextBox PlaceholderText="Enter description" 
                 Text="{Binding NotificationDescription}"/>
        <Button Content="Show" 
                Command="{Binding SendNotificationCommand}"/>
    </StackPanel>
</UserControl>
