<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Kyanite.Modules.Default.ToDoList.ToDoListView">
	<StackPanel>
        <Button Content="Create new element"
                Command="{Binding OpenAddNewDialogCommand}"/>

        <TextBlock Text="To-Do List: "/>

        <ItemsControl ItemsSource="{Binding ToDoElements}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,10,0,0"
                          CornerRadius="5"
                          BorderBrush="Gray" BorderThickness="1"
                          Padding="5">
                         <DockPanel>
                             <Button DockPanel.Dock="Right"
                                    Content="Remove"
                                    Command="{Binding $parent[UserControl].DataContext.RemoveToDoElementCommand}"
                                    CommandParameter="{Binding}"/>

                             <CheckBox DockPanel.Dock="Left"
                                       IsChecked="{Binding IsCompleted}" 
                                       Content="{Binding Name}"/>
                         </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
	</StackPanel>
</UserControl>
