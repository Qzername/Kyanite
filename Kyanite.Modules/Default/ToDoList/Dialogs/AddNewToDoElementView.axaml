<UserControl
    x:Class="Kyanite.Modules.Default.ToDoList.Dialogs.AddNewToDoElementView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <StackPanel Margin="16" Spacing="12">
        <TextBox PlaceholderText="Task name..." Text="{Binding ToDoElementName}" />

        <Grid ColumnDefinitions="*,*">
            <CalendarDatePicker
                Grid.Column="0"
                Margin="0,0,6,0"
                HorizontalAlignment="Stretch"
                SelectedDate="{Binding DueDate}" />

            <TimePicker
                Grid.Column="1"
                Margin="6,0,0,0"
                HorizontalAlignment="Stretch"
                ClockIdentifier="24HourClock"
                SelectedTime="{Binding DueTime}"
                UseSeconds="False" />
        </Grid>
        <Grid ColumnDefinitions="*,*">
            <ComboBox
                Grid.Column="1"
                Margin="6,0,0,0"
                HorizontalAlignment="Stretch"
                ItemsSource="{Binding AvailablePriorities}"
                PlaceholderText="Priority"
                SelectedItem="{Binding Priority}" />

            <TextBox
                Grid.Column="0"
                PlaceholderText="Tags (comma-separated, e.g. Work, Home)..."
                Text="{Binding TagsInput}" />
        </Grid>
    </StackPanel>
</UserControl>
