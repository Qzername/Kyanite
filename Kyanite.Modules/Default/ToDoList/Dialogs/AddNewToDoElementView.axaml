<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kyanite.Modules.Default.ToDoList.Dialogs"
             x:Class="Kyanite.Modules.Default.ToDoList.Dialogs.AddNewToDoElementView"
             x:DataType="vm:AddNewToDoElementViewModel">
    
    <Border Background="#1E1E1E" Padding="24">
        <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">
            
            <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,16">
                <TextBlock Text="Task Name" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                <TextBox Text="{Binding ToDoElementName}" 
                         PlaceholderText="Enter task name..." 
                         Background="#2D2D2D" Foreground="White" BorderBrush="#3E3E3E" Padding="8,6"/>
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="*, 16, *" Margin="0,0,0,16">
                
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="Due Date" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                    <DatePicker SelectedDate="{Binding DueDate}" 
                                Background="#2D2D2D" Foreground="White" BorderBrush="#3E3E3E"
                                HorizontalAlignment="Stretch"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Text="Due Time (Optional)" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                    <TimePicker SelectedTime="{Binding DueTime}"
                                UseSeconds="False"
                                ClockIdentifier="24HourClock"
                                Background="#2D2D2D" Foreground="White" BorderBrush="#3E3E3E"
                                HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*, 16, *" Margin="0,0,0,16">
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="Tags" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                    <TextBox PlaceholderText="e.g. Work, Home"
                             Background="#2D2D2D" Foreground="White" BorderBrush="#3E3E3E" Padding="8,6"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Text="Priority" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                    <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Select priority..."
                              Background="#2D2D2D" Foreground="White" BorderBrush="#3E3E3E" Padding="8,6">
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Border Grid.Row="3" Height="20"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button Content="Cancel" 
                        Command="{Binding CancelCommand}"
                        Background="Transparent" Foreground="#E0E0E0" BorderBrush="#3E3E3E"
                        Padding="16,8"/>
                <Button Content="Add" 
                        Command="{Binding AddCommand}"
                        Classes="accent" 
                        Padding="16,8"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>