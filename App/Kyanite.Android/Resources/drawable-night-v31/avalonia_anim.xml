<animated-vector
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:aapt="http://schemas.android.com/aapt">
  <aapt:attr name="android:drawable">
	  <vector xmlns:android="http://schemas.android.com/apk/res/android"
	  xmlns:aapt="http://schemas.android.com/aapt"
	  android:width="144dp"
	  android:height="144dp"
	  android:viewportWidth="144"
	  android:viewportHeight="144">

		  <!-- Centers the 102px wide graphic inside the 144px square canvas -->
		  <group android:translateX="21">

			  <!-- Path 0 -->
			  <path
				  android:name="path0"
				  android:pathData="M101.5 72L51 0L91.5 69L101 73L101.5 72Z">
				  <aapt:attr name="android:fillColor">
					  <gradient
						  android:type="linear"
						  android:startX="8" android:startY="-28"
						  android:endX="97" android:endY="66.5"
						  android:tileMode="clamp">
						  <item android:color="#B3CBDC" android:offset="0.0"/>
						  <item android:color="#57A5DC" android:offset="1.0"/>
					  </gradient>
				  </aapt:attr>
			  </path>

			  <!-- Path 1 -->
			  <path
				  android:name="path1"
				  android:pathData="M51 0L23 67.5L61 99L91.5 69L51 0Z">
				  <aapt:attr name="android:fillColor">
					  <gradient
						  android:type="linear"
						  android:startX="-3.5" android:startY="0"
						  android:endX="92" android:endY="102.5"
						  android:tileMode="clamp">
						  <item android:color="#BEECFF" android:offset="0.0"/>
						  <item android:color="#51CBFF" android:offset="1.0"/>
					  </gradient>
				  </aapt:attr>
			  </path>

			  <!-- Path 2 -->
			  <path
				  android:name="path2"
				  android:pathData="M101 73L52 144L61 99L91.5 69L101 73Z">
				  <aapt:attr name="android:fillColor">
					  <gradient
						  android:type="linear"
						  android:startX="71.5" android:startY="83.5"
						  android:endX="89" android:endY="147.5"
						  android:tileMode="clamp">
						  <item android:color="#42689E" android:offset="0.0"/>
						  <item android:color="#0F1B2C" android:offset="1.0"/>
					  </gradient>
				  </aapt:attr>
			  </path>

			  <!-- Path 3 -->
			  <path
				  android:name="path3"
				  android:pathData="M23 67.5L3 78L52 144L61 99L23 67.5Z">
				  <aapt:attr name="android:fillColor">
					  <gradient
						  android:type="linear"
						  android:startX="12" android:startY="50"
						  android:endX="71.5" android:endY="152"
						  android:tileMode="clamp">
						  <item android:color="#5497D6" android:offset="0.0"/>
						  <item android:color="#345776" android:offset="1.0"/>
					  </gradient>
				  </aapt:attr>
			  </path>

			  <!-- Path 4 -->
			  <path
				  android:name="path4"
				  android:pathData="M51 0L0 74L3 78L23 67.5L51 0Z">
				  <aapt:attr name="android:fillColor">
					  <gradient
						  android:type="linear"
						  android:startX="0" android:startY="0"
						  android:endX="46" android:endY="78"
						  android:tileMode="clamp">
						  <item android:color="#E1F7FF" android:offset="0.0"/>
						  <item android:color="#A4E7FF" android:offset="1.0"/>
					  </gradient>
				  </aapt:attr>
			  </path>

		  </group>
	  </vector>
  </aapt:attr>
  <target android:name="path">
    <aapt:attr name="android:animation">
      <objectAnimator
        android:propertyName="fillColor"
        android:duration="1000"
        android:valueFrom="#00ffffff"
        android:valueTo="#161c2d"
        android:valueType="colorType"
        android:interpolator="@android:interpolator/fast_out_slow_in"/>
    </aapt:attr>
  </target>
  <target android:name="path_1">
    <aapt:attr name="android:animation">
      <objectAnimator
        android:propertyName="fillColor"
        android:duration="1000"
        android:valueFrom="#00ffffff"
        android:valueTo="#f9f9fb"
        android:valueType="colorType"
        android:interpolator="@android:interpolator/fast_out_slow_in"/>
    </aapt:attr>
  </target>
  <target android:name="path_2">
    <aapt:attr name="android:animation">
      <objectAnimator
        android:propertyName="fillColor"
        android:duration="1000"
        android:valueFrom="#00ffffff"
        android:valueTo="#f9f9fb"
        android:valueType="colorType"
        android:interpolator="@android:interpolator/fast_out_slow_in"/>
    </aapt:attr>
  </target>
</animated-vector>
