<UserControl
    x:Class="Kyanite.Views.InitialConfiguration.Pages.PickDatabaseStackView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <StackPanel>
        <TextBlock Text="Pick your database stack" />
        <ComboBox ItemsSource="{Binding AvailableStacks}" SelectedItem="{Binding PickedDatabaseStack}" />
    </StackPanel>
</UserControl>
