<UserControl x:Class="Kyanite.Views.InitialConfiguration.InitialConfigurationView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewLocators="using:Kyanite.ViewLocators"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d"
             x:CompileBindings="False">
	<Panel>
		<TextBlock Margin="50"
		           HorizontalAlignment="Center"
		           VerticalAlignment="Top"
		           Text="Welcome to Kyanite" />

		<Panel Width="300"
		       Height="600"
		       HorizontalAlignment="Center"
		       VerticalAlignment="Center"
		       Background="Gray">
			<ContentControl Content="{Binding CurrentPageViewModel}">
				<ContentControl.DataTemplates>
					<viewLocators:MainViewLocator />
					<viewLocators:DatabaseInitializationViewLocator />
				</ContentControl.DataTemplates>
			</ContentControl>

			<DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
				<Button Content="Next"
				        DockPanel.Dock="Right"
				        Command="{Binding GoToNextPageCommand}" />
				<Button Content="Previous"
				        DockPanel.Dock="Left"
				        Command="{Binding GoToPreviousPageCommand}" />
			</DockPanel>
		</Panel>
	</Panel>
</UserControl>
