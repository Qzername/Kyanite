<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:Kyanite.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Kyanite.Views.MainWindow"
	   x:CompileBindings="False"
        
        xmlns:modulePicker="using:Kyanite.Controls.ModulePicker"
		
        ExtendClientAreaToDecorationsHint="True"
        Icon="/Assets/avalonia-logo.ico"
        Title="Kyanite">

    <Window.Styles>
        <!-- Hide default title bar -->
        <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel > TextBlock">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- Hide full screen button (not the maximalize window) -->
        <Style Selector="WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ StackPanel#PART_OverlayPanel">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <!-- this fixes gap between last button and edge-->
            <Setter Property="Width" Value="138"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <Panel DockPanel.Dock="Top"
               Height="30" Background="#0F0E0F"
               WindowDecorationProperties.ElementRole="TitleBar">

            <TextBlock VerticalAlignment="Center" Padding="5,0" Foreground="#0012DE" Text="Kyanite"/>
        </Panel>

        <Panel>
		   <views:ShellView />

		   <!--Dialog system-->
		   <!--TODO: move it to another control-->
			<Panel IsVisible="{Binding DialogService.CurrentDialog, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <Panel VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="#99393939" ></Panel>
                  <Panel Width="500" Height="400" VerticalAlignment="Center" HorizontalAlignment="Center" Background="Black">
                    <ContentControl Content="{Binding DialogService.CurrentDialog.ViewModel}" >
						<!--TODO: make it not hardcoded-->
						<ContentControl.DataTemplates>
							<DataTemplate DataType="modulePicker:ModulePickerViewModel">
								<modulePicker:ModulePickerView/>
							</DataTemplate>
						</ContentControl.DataTemplates>
					</ContentControl>
				  </Panel>

				 <!--TODO: Make the button so that it will be in ModuleBuilder-->
				 <Button Command="{Binding CloseDialogCommand}" Content="Close"/>
             </Panel>

	   </Panel>
    </DockPanel>
</Window>
