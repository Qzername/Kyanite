<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:vm="using:Kyanite.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Kyanite.Views.MainView"
             x:DataType="vm:MainViewModel"
			 
			 xmlns:noteModule="clr-namespace:Kyanite.Modules.Note;assembly=Kyanite.Modules"
	
			 FontFamily="Unbounded">
	
	<Grid ColumnDefinitions="Auto, *">
		<suki:SukiSideMenu Grid.Column="0">

			<suki:SukiSideMenu.Items>
				<ListBox Background="Transparent">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="test"/>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</suki:SukiSideMenu.Items>

			<suki:SukiSideMenu.FooterContent>
				<StackPanel Orientation="Horizontal">

					<Button Content="Create Module" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
							Command="{Binding CreateModuleCommand}"/>

				</StackPanel>
			</suki:SukiSideMenu.FooterContent>
		</suki:SukiSideMenu>
		
		<Grid Grid.Column="1" RowDefinitions="Auto,*">
			<StackPanel Grid.Row="0"
						Orientation="Horizontal"
						IsEnabled="{Binding IsLoaded}">

				<Button Content="Load Module"
						Command="{Binding LoadModuleCommand}"/>

				<Button Content="Save Module"
						Command="{Binding SaveModuleCommand}"/>
			</StackPanel>

			<ContentControl Grid.Row="1"
							Content="{Binding CurrentModule}">
				<ContentControl.DataTemplates>
					<DataTemplate DataType="noteModule:NoteViewModel">
						<noteModule:NoteView />
					</DataTemplate>
				</ContentControl.DataTemplates>
			</ContentControl>
		</Grid>

	</Grid>
</UserControl>
