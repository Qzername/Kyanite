<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Kyanite.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Kyanite.Views.MainView"
             x:DataType="vm:MainViewModel"
			 
			 xmlns:noteModule="clr-namespace:Kyanite.Modules.Note;assembly=Kyanite.Modules"
			 
			 FontFamily="Unbounded">
  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainViewModel />
  </Design.DataContext>
	
	<SplitView IsPaneOpen="{Binding IsPaneOpen}"
			   DisplayMode="CompactInline"
			   
			   CompactPaneLength="48"
			   OpenPaneLength="200">
		<SplitView.Pane>
			<DockPanel>
				<Button DockPanel.Dock="Bottom" 
						Content="Create Module" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
						Command="{Binding CreateModuleCommand}"/>
			
				<Button DockPanel.Dock="Top"
						Content="☰" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
						Command="{Binding TogglePaneCommand}" />

				<ListBox Background="Transparent">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="test"/>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</DockPanel>
		</SplitView.Pane>
		
		<Grid RowDefinitions="Auto,*">
			<StackPanel Grid.Row="0" 
						Orientation="Horizontal"
						IsEnabled="{Binding IsLoaded}">
				
				<Button Content="Load Module"
						Command="{Binding LoadModuleCommand}"/>

				<Button Content="Save Module"
						Command="{Binding SaveModuleCommand}"/>
			</StackPanel>

			<ContentControl Grid.Row="1"
							Content="{Binding CurrentModule}">
				<ContentControl.DataTemplates>
					<DataTemplate DataType="noteModule:NoteViewModel">
						<noteModule:NoteView />
					</DataTemplate>
				</ContentControl.DataTemplates>
			</ContentControl>
		</Grid>
	</SplitView>
	
</UserControl>
