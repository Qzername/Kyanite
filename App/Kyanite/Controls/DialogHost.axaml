<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewLocators="using:Kyanite.ViewLocators"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Kyanite.Controls.DialogHost"
             x:CompileBindings="False">
    <Panel IsVisible="{Binding DialogService.CurrentDialog, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Border HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="#99393939"
                PointerPressed="OnScrimPressed"/>

        <Border Width="{Binding DialogService.CurrentDialog.Width}"
                Height="{Binding DialogService.CurrentDialog.Height}"
                MinWidth="320"
                MinHeight="180"
                MaxWidth="1000"
                MaxHeight="760"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#1B1B1B"
                BorderBrush="#3A3A3A"
                BorderThickness="1"
                CornerRadius="8">
            <Border.Styles>
                <Style Selector="Button">
                    <Setter Property="Margin" Value="6,0,0,0"/>
                    <Setter Property="Padding" Value="14,6"/>
                </Style>
            </Border.Styles>

            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#232323" Padding="16,10">
                    <TextBlock Text="{Binding DialogService.CurrentDialog.Title}"
                               FontWeight="Bold"
                               FontSize="16"/>
                </Border>

                <ItemsControl DockPanel.Dock="Bottom"
                              HorizontalAlignment="Right"
                              Margin="16,8,16,12"
                              ItemsSource="{Binding DialogService.CurrentDialog.Buttons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding Command}" Content="{Binding Content}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ContentControl Content="{Binding DialogService.CurrentDialog.ViewModel}" Margin="16">
                        <ContentControl.DataTemplates>
                            <viewLocators:MainViewLocator/>
                        </ContentControl.DataTemplates>
                    </ContentControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Panel>
</UserControl>
