<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:Kyanite.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Kyanite.Views.MainWindow"
        
        ExtendClientAreaToDecorationsHint="True"
        Icon="/Assets/avalonia-logo.ico"
        Title="Kyanite">
    
    <Window.Styles>
        <!-- Hide default title bar -->
        <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel > TextBlock">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- Hide full screen button (not the maximalize window) -->
        <Style Selector="WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <Panel DockPanel.Dock="Top"
               Height="30" Background="#0F0E0F"
               WindowDecorationProperties.ElementRole="User">

            <Panel Background="Transparent"
                   WindowDecorationProperties.ElementRole="TitleBar" />

            <TextBlock VerticalAlignment="Center" Padding="5,0" Foreground="#0012DE" Text="Kyanite"/>
        </Panel>
        <views:MainView />
    </DockPanel>
</Window>
