<Application
	x:Class="Kyanite.App"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:viewLocators="using:Kyanite.ViewLocators"
	x:CompileBindings="False"
	RequestedThemeVariant="Dark">

	<Application.DataTemplates>
		<viewLocators:MainViewLocator />
	</Application.DataTemplates>

	<Application.Resources>
		<FontFamily x:Key="Unbounded">avares://Kyanite/Assets#Unbounded</FontFamily>

		<ControlTheme x:Key="FlyoutBorderTheme" TargetType="Border"/>
	</Application.Resources>

	<TrayIcon.Icons>
		<TrayIcons>
			<TrayIcon
				Command="{Binding OpenApplicationCommand}"
				Icon="/Assets/kyanite-logo.ico"
				ToolTipText="Kyanite">
				<TrayIcon.Menu>
					<NativeMenu>
						<NativeMenuItem Command="{Binding CloseApplicationCommand}" Header="Close application" />
					</NativeMenu>
				</TrayIcon.Menu>
			</TrayIcon>
		</TrayIcons>
	</TrayIcon.Icons>

	<Application.Styles>
		<PleasantTheme />
	</Application.Styles>
</Application>
