<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="using:Whiteboard"
             
			 x:Class="Whiteboard.App"
             RequestedThemeVariant="Default">

	<TrayIcon.Icons>
		<TrayIcons>
			<TrayIcon Command="{Binding OpenApplication}" Icon="/Assets/avalonia-logo.ico"
					  ToolTipText="Whiteboard">
				<TrayIcon.Menu>
					<NativeMenu>
						<NativeMenuItem Command="{Binding CloseApplication}" Header="Close application"/>
					</NativeMenu>
				</TrayIcon.Menu>
			</TrayIcon>
		</TrayIcons>
	</TrayIcon.Icons>
	
	<Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
